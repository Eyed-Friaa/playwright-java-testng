<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.framework</groupId>
    <artifactId>playwright-java-testng</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Playwright Java TestNG Framework</name>
    <description>Enterprise-grade test automation framework with Playwright, Java, TestNG and Allure reporting</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Default suite — overridden by -Psmoke / -Pregression / -Papi -->
        <suiteFile>src/test/resources/suites/smoke.xml</suiteFile>

        <!-- Core versions -->
        <playwright.version>1.44.0</playwright.version>
        <testng.version>7.10.2</testng.version>
        <allure.version>2.35.4</allure.version>
        <aspectj.version>1.9.25.1</aspectj.version>
        <slf4j.version>2.0.13</slf4j.version>
        <logback.version>1.5.6</logback.version>
        <jackson.version>2.22.2</jackson.version>
        <lombok.version>1.18.46</lombok.version>
        <datafaker.version>2.2.2</datafaker.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <assertj.version>3.26.0</assertj.version>
        <owner.version>1.0.12</owner.version>

        <!-- Plugin versions -->
        <surefire.version>3.2.5</surefire.version>
        <exec-plugin.version>3.2.0</exec-plugin.version>
        <compiler-plugin.version>3.13.0</compiler-plugin.version>
        <allure-maven.version>3.0.3</allure-maven.version>
    </properties>

    <dependencies>

        <!-- ===== PLAYWRIGHT ===== -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- ===== TESTNG ===== -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <!-- ===== ALLURE REPORTING ===== -->
        <!-- allure-testng transitively provides allure-java-commons (Allure.addAttachment, @Step) -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-testng</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- ===== ASPECTJ WEAVER (required by Allure @Step interception) ===== -->
        <!-- Declared as a dependency so Surefire can resolve it via the
             ${org.aspectj:aspectjweaver:jar} token in argLine — no copy hacks. -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- ===== REST ASSURED (API Testing) ===== -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>

        <!-- Allure ↔ REST Assured bridge: attaches request/response to each step. -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
            <version>${allure.version}</version>
        </dependency>

        <!-- ===== ASSERTIONS ===== -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
        </dependency>

        <!-- ===== DATA / MODELS ===== -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>net.datafaker</groupId>
            <artifactId>datafaker</artifactId>
            <version>${datafaker.version}</version>
        </dependency>

        <!-- ===== LOMBOK ===== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ===== CONFIG ===== -->
        <dependency>
            <groupId>org.aeonbits.owner</groupId>
            <artifactId>owner</artifactId>
            <version>${owner.version}</version>
        </dependency>

        <!-- ===== LOGGING ===== -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- Compiler with Lombok annotation processing -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Maven Surefire (TestNG runner) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <suiteXmlFiles>
                        <suiteXmlFile>${suiteFile}</suiteXmlFile>
                    </suiteXmlFiles>
                    <!-- AspectJ weaver (required by Allure @Step interception).
                         aspectjweaver is a declared dependency, so Maven downloads it
                         to the local repo; ${settings.localRepository} interpolates to
                         that path. No inner quotes (the .m2 path has no spaces). -->
                    <argLine>-javaagent:${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar</argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                    <properties>
                        <property>
                            <name>usedefaultlisteners</name>
                            <value>false</value>
                        </property>
                    </properties>
                </configuration>
            </plugin>

            <!-- Allure report generation (mvn allure:report / allure:serve) -->
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure-maven.version}</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                </configuration>
            </plugin>

            <!-- Exec plugin installs Playwright browsers via the CLI main class.
                 Run: mvn exec:java -Dexec.args="install" (add browser name + deps flag as needed) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-plugin.version}</version>
                <configuration>
                    <mainClass>com.microsoft.playwright.CLI</mainClass>
                    <classpathScope>compile</classpathScope>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- Suite selection profiles -->
    <profiles>
        <profile>
            <id>smoke</id>
            <properties>
                <suiteFile>src/test/resources/suites/smoke.xml</suiteFile>
            </properties>
        </profile>
        <profile>
            <id>regression</id>
            <properties>
                <suiteFile>src/test/resources/suites/regression.xml</suiteFile>
            </properties>
        </profile>
        <profile>
            <id>api</id>
            <properties>
                <suiteFile>src/test/resources/suites/api.xml</suiteFile>
            </properties>
        </profile>
    </profiles>

</project>

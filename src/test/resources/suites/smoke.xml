<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Smoke Suite" verbose="1" parallel="methods" thread-count="2">

    <listeners>
        <listener class-name="com.framework.hooks.TestListener"/>
        <listener class-name="com.framework.hooks.RetryListener"/>
    </listeners>

    <test name="Smoke - Login">
        <classes>
            <class name="com.framework.tests.ui.LoginTest">
                <methods>
                    <include name="standardUserCanLogin"/>
                    <include name="invalidCredentialsShowError"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Smoke - API">
        <classes>
            <class name="com.framework.tests.api.UserApiTest">
                <methods>
                    <include name="getUsersReturnsList"/>
                    <include name="createUserReturns201WithId"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1" parallel="classes" thread-count="4">

    <listeners>
        <listener class-name="com.framework.hooks.TestListener"/>
        <listener class-name="com.framework.hooks.RetryListener"/>
        <!-- Filters methods to a shard when -Dshard.total > 1; no-op otherwise. -->
        <listener class-name="com.framework.hooks.ShardInterceptor"/>
    </listeners>

    <test name="UI Tests">
        <packages>
            <package name="com.framework.tests.ui"/>
        </packages>
    </test>

    <test name="API Tests">
        <packages>
            <package name="com.framework.tests.api"/>
        </packages>
    </test>

</suite>
